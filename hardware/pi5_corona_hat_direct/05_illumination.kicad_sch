	(text "J50 on HAT; J51 on mini board. Cable pin 1 GND, 2 3V3, 3 SDA, 4 SCL."
		(at 25.4 140.97 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "b4158a02-e05b-40cb-bbb1-fdacace8f677")
	)
	(text "Route only these four nets across the scored break-off neck; cutting the neck severs all four."
		(at 25.4 148.59 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "dfbe9fb6-0d0c-42fd-86b2-d3e271ed767f")
	)
	(text "After detaching, a 1:1 Qwiic / STEMMA QT cable restores all four connections. 3.3 V only."
		(at 25.4 156.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "cdaaf612-b955-44f8-ad1b-8fde52ef4187")
	)
	(text "Keep C80/C81 beside U8. No local pull-ups or LEDs; use the Pi bus pull-ups."
		(at 25.4 163.83 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "af8d03ce-70bf-44ff-8644-6cccde46c27b")
	)
	(text "Keep the optical aperture and copper neck away from high-voltage circuitry; start cable operation at 100 kHz."
		(at 25.4 171.45 0)
		(effects
			(font
				(size 1.016 1.016)
			)
			(justify left)
		)
		(uuid "bbf962cf-02cb-4bbf-8647-97395319b867")
	)
