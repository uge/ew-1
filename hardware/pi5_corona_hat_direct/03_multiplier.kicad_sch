	(text "1. Nominal open-circuit output voltage: ~17 kV DC (regulated by MCU PWM duty cycle to +10 kV .. +15 kV DC)."
		(at 38.10 226.06 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left)
		)
		(uuid "b3f82a52-ad68-4ac7-8387-c26737548aa1")
	)
	(text "2. BLEEDERS: 12 banks x 3 series 100M / 3kV 2512; each bank is 300M. Verify <50V discharge on assembled hardware."
		(at 38.10 232.41 0)
		(effects
			(font
				(size 1.524 1.524)
			)
			(justify left)
		)
		(uuid "60b2a8c3-b97c-44c8-a324-4bb92a5b328a")
	)
	(text "3. CLEARANCE: Minimum 4.0 mm clearance maintained between adjacent stages; all inner copper planes removed beneath ladder."
